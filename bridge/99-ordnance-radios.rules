# Option A (Preferred): Match by unique USB serial number
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_MESHTASTIC_SERIAL", SYMLINK+="ordnance-meshtastic", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{serial}=="REPLACE_MESHCORE_SERIAL",   SYMLINK+="ordnance-meshcore",   GROUP="dialout", MODE="0660"

# Option B (Fallback for duplicate CP2102/CH340 serials): Match by physical RPi 5 USB port
# Label your physical ports on the Pi 5 (e.g., Top USB-A = Meshtastic, Bottom USB-A = MeshCore)
# SUBSYSTEM=="tty", KERNELS=="1-1.1", SYMLINK+="ordnance-meshtastic", GROUP="dialout", MODE="0660"
# SUBSYSTEM=="tty", KERNELS=="1-1.2", SYMLINK+="ordnance-meshcore",   GROUP="dialout", MODE="0660"